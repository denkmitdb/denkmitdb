# denkmitd configuration (systemd EnvironmentFile). Keep this file mode 600:
# the passphrase encrypts this node's signing key at rest.

DENKMIT_PASSPHRASE=change-me-to-a-long-random-secret
DENKMIT_IDENTITY=agent

# Open an existing database by address, or leave unset to create one on first start
# (its address is remembered in the data directory).
#DENKMIT_DB=bafyrei...
DENKMIT_DB_NAME=agent-memory

# Access preset for a database this daemon creates: creator-only | public |
# prefix-per-writer | namespace-per-writer | allowlist:<cid>,<cid>
DENKMIT_ACCESS=namespace-per-writer
# Or custom json-logic policies (docs/policies.md); an accessPolicy here replaces DENKMIT_ACCESS.
#DENKMIT_POLICY_FILE=/home/you/.config/denkmit/policies.json

# libp2p: where to listen (default /ip4/0.0.0.0/tcp/4001), what to announce to peers
# (set your public address on a server), and peers to dial at start.
#DENKMIT_LISTEN=/ip4/0.0.0.0/tcp/4001,/ip6/::/tcp/4001
#DENKMIT_ANNOUNCE=/ip4/203.0.113.10/tcp/4001,/dns4/seed.example.org/tcp/4001
#DENKMIT_PEERS=/dns4/seed.example.org/tcp/4001

# mDNS finds peers on the local network; pointless on a server.
#DENKMIT_MDNS=off

# Separate identities per agent; agents then set DENKMIT_AGENT=<name> in their MCP config.
#DENKMIT_AGENTS=claude-code,codex,desktop

#DENKMIT_DATADIR=/home/you/.denkmit-mcp
#DENKMIT_MAX_VALUE_BYTES=65536
