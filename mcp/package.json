{
    "name": "@denkmitdb/mcp",
    "version": "0.3.0",
    "description": "MCP thin client for denkmitd: gives Claude Code, Codex, Claude Desktop and other MCP clients shared, signed agent memory on DenkMitDB",
    "type": "module",
    "bin": {
        "denkmit-mcp": "dist/index.js"
    },
    "main": "./dist/index.js",
    "files": [
        "dist",
        "src"
    ],
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "build": "rm -rf dist && tsc",
        "start": "node dist/index.js",
        "smoke": "node dist/smoke.js",
        "demo": "node dist/demo.js",
        "smoke:daemon": "node dist/smoke-daemon.js"
    },
    "author": "Askar Zhakenov <askar@zhakenov.pro>",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/denkmitdb/denkmitdb.git",
        "directory": "mcp"
    },
    "dependencies": {
        "@denkmitdb/node": "workspace:^",
        "@modelcontextprotocol/sdk": "^1.32.2"
    },
    "devDependencies": {
        "@denkmitdb/denkmitdb": "workspace:^",
        "@types/node": "^26.6.6",
        "@typescript/native": "npm:typescript@^7.0.2"
    },
    "publishConfig": {
        "access": "public"
    }
}
