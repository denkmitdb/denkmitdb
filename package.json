{
    "name": "@denkmitdb/denkmitdb",
    "version": "3.0.0",
    "description": "Distributed Merkle Tree Database on IPFS",
    "main": "./dist/functions/index.js",
    "publishConfig": {
        "access": "public"
    },
    "type": "module",
    "types": "./dist/functions/index.d.ts",
    "files": [
        "src",
        "dist",
        "!dist/test",
        "!**/*.tsbuildinfo"
    ],
    "exports": {
        ".": {
            "types": "./dist/functions/index.d.ts",
            "import": "./dist/functions/index.js"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "rm -rf dist && tsc && tsc --declaration --emitDeclarationOnly",
        "docs": "typedoc",
        "lint": "eslint src test examples vitest.config.ts",
        "typecheck": "tsc -p tsconfig.test.json --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:package": "node scripts/package-smoke.mjs"
    },
    "keywords": [
        "denkmitdb",
        "denkmitdb-typescript"
    ],
    "engines": {
        "node": ">=22"
    },
    "author": "Askar Zhakenov <askar@zhakenov.pro>",
    "license": "MIT",
    "homepage": "https://github.com/denkmitdb/denkmitdb",
    "repository": {
        "type": "git",
        "url": "https://github.com/denkmitdb/denkmitdb.git"
    },
    "bugs": {
        "url": "https://github.com/denkmitdb/denkmitdb/issues"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@helia/bitswap": "^4.0.20",
        "@helia/libp2p": "^2.1.5",
        "@microsoft/tsdoc": "^0.17.1",
        "@ptkdev/all-shields-cli": "^2.0.2",
        "@types/node": "^26.6.6",
        "@typescript-eslint/eslint-plugin": "^8.72.1",
        "@typescript-eslint/parser": "^8.72.1",
        "@typescript/native": "npm:typescript@^7.0.2",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-formatter-unix": "^9.0.1",
        "eslint-plugin-tsdoc": "^0.5.4",
        "globals": "^17.14.0",
        "helia": "^7.1.16",
        "prettier": "^3.9.10",
        "tsx": "^4.23.15",
        "typedoc": "^0.28.20",
        "typedoc-plugin-markdown": "^4.14.1",
        "typedoc-plugin-mdn-links": "^5.1.1",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "typescript-eslint": "^8.72.1",
        "vitest": "^5.1.0"
    },
    "dependencies": {
        "@chainsafe/libp2p-noise": "^17.0.0",
        "@chainsafe/libp2p-yamux": "^8.0.1",
        "@helia/dag-cbor": "^6.0.6",
        "@helia/interface": "^7.1.2",
        "@ipld/dag-cbor": "^10.0.2",
        "@libp2p/floodsub": "^11.1.1",
        "@libp2p/identify": "^4.1.18",
        "@libp2p/interface": "^3.4.0",
        "@libp2p/logger": "^6.2.16",
        "@libp2p/tcp": "^11.0.32",
        "@types/json-logic-js": "^2.0.8",
        "delay": "^7.0.0",
        "interface-datastore": "^10.0.1",
        "it-drain": "^3.0.12",
        "jose": "^6.2.15",
        "js-sdsl": "^4.4.2",
        "json-logic-js": "^2.0.5",
        "keyv": "^6.1.0",
        "libp2p": "^3.5.1",
        "multiformats": "^14.0.5",
        "p-queue": "^10.0.0",
        "timeout-abort-controller": "^3.0.0",
        "uint8arrays": "^6.1.1",
        "utility-types": "^3.11.0"
    },
    "packageManager": "pnpm@12.18.0"
}
